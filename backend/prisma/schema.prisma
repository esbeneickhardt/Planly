generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ────────────────────────────────────────────────────────────────────

enum TeamRole {
  member
  co_owner
}

enum PermissionLevel {
  write
  read
  none
}

enum AccessRequestStatus {
  pending
  approved
  rejected
}

enum ProductStatus {
  active
  completed
  archived
}

// ── Core models ──────────────────────────────────────────────────────────────

model User {
  id                String   @id @default(uuid())
  username          String   @unique
  email             String   @unique
  realName          String?
  phone             String?
  avatarEmoji       String?
  avatarUrl         String?
  passwordHash      String?
  emailVerified     Boolean  @default(true)
  ssoProvider       String?
  ssoSub            String?
  isAdmin           Boolean  @default(false)
  isFoundingAdmin   Boolean  @default(false)
  mustChangePassword      Boolean  @default(false)
  failedLoginAttempts     Int      @default(0)
  loginLockedUntil        DateTime?
  loginLockCount          Int      @default(0) // increments on each lockout for progressive penalties
  notificationPreferences Json      @default("{}")
  acceptsInvites          Boolean   @default(true)
  tokenVersion            Int       @default(0)
  tosAcceptedAt           DateTime?
  tosVersion              String?
  totpSecret              String?
  totpEnabled             Boolean   @default(false)
  lastLoginAt             DateTime?
  lastActiveAt            DateTime?
  createdAt               DateTime  @default(now())

  teams               TeamMember[]
  ownedTasks          Task[]               @relation("TaskOwner")
  completedTasks      Task[]               @relation("TaskCompleter")
  createdTasks        Task[]               @relation("TaskCreator")
  reviewedTasks       Task[]               @relation("TaskReviewer")
  completedSubtasks   Subtask[]            @relation("SubtaskCompleter")
  canvasSnapshots     CanvasSnapshot[]
  tabPermissions      TabPermission[]
  messages            Message[]
  messageReactions    MessageReaction[]
  ownedProducts       Product[]            @relation("ProductOwner")
  accessRequests      AccessRequest[]
  apiTokens           ApiToken[]           @relation("UserApiTokens")
  refreshTokens       RefreshToken[]       @relation("UserRefreshTokens")
  ownedApps           AppRegistration[]    @relation("OwnedApps")
  notifications       Notification[]
  passwordResetTokens PasswordResetToken[]
  emailVerifyTokens   EmailVerifyToken[]
  announcements       Announcement[]
  announcementComments AnnouncementComment[]
  fileUploads         FileUpload[]
  totpBackupCodes     TotpBackupCode[]
  receivedInvites     TeamInvite[]         @relation("ReceivedInvites")
  conversations       ConversationParticipant[]
  directMessages      DirectMessage[]
}

model Team {
  id        String    @id @default(uuid())
  name      String
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  members       TeamMember[]
  products      Product[]
  invites       TeamInvite[]
  announcements Announcement[]
}

model TeamMember {
  teamId String
  userId String
  role   TeamRole @default(member)

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([teamId, userId])
  @@index([userId])
}

model Product {
  id               String    @id @default(uuid())
  name             String
  emoji            String?
  description      String?
  deadline         DateTime
  teamId           String
  ownerId          String?
  status           ProductStatus @default(active)
  analyticsEnabled Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @default(now()) @updatedAt
  deletedAt        DateTime?

  team               Team                @relation(fields: [teamId], references: [id])
  ownerUser          User?               @relation("ProductOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  tasks              Task[]
  kanbanColumns      KanbanColumn[]
  productConnections ProductConnection[]
  colorLegendEntries ColorLegendEntry[]
  sprints            Sprint[]
  canvasSnapshots    CanvasSnapshot[]
  tabPermissions     TabPermission[]
  messages           Message[]
  accessRequests     AccessRequest[]
  webhooks           Webhook[]
  fileUploads        FileUpload[]
  conversations      Conversation[]

  @@index([teamId])
  @@index([ownerId])
}

model KanbanColumn {
  id        String   @id @default(uuid())
  productId String
  label     String
  color     String   @default("#64748b")
  order     Int
  isDone    Boolean  @default(false)
  statusKey String
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, statusKey])
  @@index([productId])
}

model Task {
  id          String    @id @default(uuid())
  productId   String
  name        String
  description String?
  status      String    @default("backlog")
  ownerId     String?
  reviewerId  String?
  color       String?
  deadline    DateTime?
  canvasX     Float?
  canvasY     Float?
  kanbanOrder Int       @default(0)
  milestoneOrder Int    @default(0)
  completedBy String?
  completedAt DateTime?
  createdBy   String?
  githubUrl   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt
  deletedAt   DateTime?

  product            Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  owner              User?             @relation("TaskOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  reviewer           User?             @relation("TaskReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  completer          User?             @relation("TaskCompleter", fields: [completedBy], references: [id])
  creator            User?             @relation("TaskCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  subtasks           Subtask[]
  dependsOn          TaskDependency[]  @relation("dependent")
  requiredBy         TaskDependency[]  @relation("prerequisite")
  productConnections ProductConnection[]
  sprintTasks        SprintTask[]
  messages           Message[]

  @@index([productId])
  @@index([ownerId])
  @@index([reviewerId])
  @@index([status])
  @@index([productId, status])
  @@index([deletedAt])
}

model TaskDependency {
  dependentId    String
  prerequisiteId String

  dependent    Task @relation("dependent",    fields: [dependentId],    references: [id], onDelete: Cascade)
  prerequisite Task @relation("prerequisite", fields: [prerequisiteId], references: [id], onDelete: Cascade)

  @@id([dependentId, prerequisiteId])
}

model Subtask {
  id          String    @id @default(uuid())
  taskId      String
  name        String
  completed   Boolean   @default(false)
  completedBy String?
  completedAt DateTime?
  order       Int       @default(0)

  task      Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  completer User? @relation("SubtaskCompleter", fields: [completedBy], references: [id])

  @@index([taskId])
}

model ProductConnection {
  productId String
  taskId    String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  task    Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@id([productId, taskId])
  @@index([taskId])
}

model ColorLegendEntry {
  id        String  @id @default(uuid())
  productId String
  colorKey  String
  name      String
  enabled   Boolean @default(true)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, colorKey])
}

model Sprint {
  id        String   @id @default(uuid())
  productId String
  name      String
  color     String   @default("#7c3aed")
  startDate DateTime
  endDate   DateTime
  createdAt DateTime @default(now())

  product     Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  sprintTasks SprintTask[]

  @@index([productId])
}

model SprintTask {
  sprintId String
  taskId   String

  sprint Sprint @relation(fields: [sprintId], references: [id], onDelete: Cascade)
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@id([sprintId, taskId])
  @@index([taskId])
}

model Message {
  id           String    @id @default(uuid())
  productId    String?
  taskId       String?
  authorId     String
  content      String
  attachments  Json      @default("[]")
  isAdminChat  Boolean   @default(false)
  replyToId    String?
  postedAsRole String?
  createdAt    DateTime  @default(now())
  editedAt     DateTime?

  product   Product?          @relation(fields: [productId], references: [id], onDelete: Cascade)
  task      Task?             @relation(fields: [taskId],    references: [id], onDelete: Cascade)
  author    User              @relation(fields: [authorId],  references: [id], onDelete: Cascade)
  replyTo   Message?          @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies   Message[]         @relation("MessageReplies")
  reactions MessageReaction[]

  @@index([productId])
  @@index([taskId])
  @@index([isAdminChat])
  @@index([replyToId])
}

model MessageReaction {
  id        String   @id @default(uuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId],    references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
}

model TabPermission {
  id        String          @id @default(uuid())
  productId String
  userId    String
  tab       String
  level     PermissionLevel @default(write)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, userId, tab])
  @@index([productId, userId])
}

model CanvasSnapshot {
  id        String   @id @default(uuid())
  productId String
  userId    String
  name      String
  positions Json
  viewport  Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model AccessRequest {
  id        String              @id @default(uuid())
  productId String
  userId    String
  note      String?
  status    AccessRequestStatus @default(pending)
  createdAt DateTime            @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, userId])
  @@index([userId])
}

// ── API access ───────────────────────────────────────────────────────────────

model ApiToken {
  id         String    @id @default(uuid())
  userId     String
  appId      String?
  productId  String?
  name       String
  tokenHash  String    @unique
  readOnly   Boolean   @default(false)
  lastUsedAt DateTime?
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())

  user User             @relation("UserApiTokens", fields: [userId], references: [id], onDelete: Cascade)
  app  AppRegistration? @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ── Refresh token rotation ────────────────────────────────────────────────────
// Short-lived JWTs (1 h) are paired with long-lived refresh tokens (30 d).
// All tokens derived from a single login share a familyId — if a rotated
// token is ever re-used, the entire family is revoked (stolen-token detection).

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  familyId  String
  tokenHash String    @unique
  rotatedAt DateTime?
  expiresAt DateTime
  createdAt DateTime  @default(now())

  user User @relation("UserRefreshTokens", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
}

model AppRegistration {
  id          String   @id @default(uuid())
  name        String
  description String?
  ownerId     String
  productId   String?
  permissions Json     @default("{}")
  createdAt   DateTime @default(now())

  owner  User       @relation("OwnedApps", fields: [ownerId], references: [id], onDelete: Cascade)
  tokens ApiToken[]

  @@index([ownerId])
}

// ── Notifications ─────────────────────────────────────────────────────────────

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String
  title     String
  body      String?
  read      Boolean  @default(false)
  productId String?
  taskId    String?
  metadata  Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, read])
}

// ── Webhooks ──────────────────────────────────────────────────────────────────

model Webhook {
  id        String   @id @default(uuid())
  productId String
  url       String
  secret    String
  events    String[]
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  product    Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@index([productId])
}

model WebhookDelivery {
  id           String   @id @default(uuid())
  webhookId    String
  event        String
  payload      Json
  statusCode   Int?
  responseBody String?
  success      Boolean  @default(false)
  createdAt    DateTime @default(now())

  webhook Webhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId])
}

// ── Team invites ──────────────────────────────────────────────────────────────

model TeamInvite {
  id        String    @id @default(uuid())
  teamId    String
  email     String?
  toUserId  String?   // set for user-targeted invites sent via Settings → Team; null for open/email links
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime? // set when consumed (email-bound: first use; open: when useCount >= maxUses)
  useCount  Int       @default(0) // how many people have accepted this link
  maxUses   Int?      // null = unlimited for open invites; 1 = single-use (default for email invites)
  createdAt DateTime  @default(now())

  team   Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  toUser User? @relation("ReceivedInvites", fields: [toUserId], references: [id], onDelete: Cascade)

  @@index([teamId])
  @@index([toUserId])
}

// ── Auth tokens ───────────────────────────────────────────────────────────────

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model EmailVerifyToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model TotpBackupCode {
  id        String   @id @default(uuid())
  userId    String
  codeHash  String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ── SMTP configuration (UI-settable, overrides env vars) ─────────────────────

model SmtpConfig {
  id        String   @id @default("default")
  host      String
  port      Int      @default(587)
  secure    Boolean  @default(false)
  user      String
  pass      String
  from      String
  updatedAt DateTime @updatedAt
}

// ── Server-wide configuration (singleton, managed in admin panel) ─────────────

model ServerConfig {
  id                       String  @id @default("main")
  requireEmailVerification Boolean @default(false)
  requireWhitelist         Boolean @default(false)
  requireBlocklist         Boolean @default(false)
  allowProjectCreation     Boolean @default(false)
  announcementsEnabled     Boolean @default(false)
  announcementPostRole     String  @default("admin")
  requireMfa               Boolean @default(false)
  ipRestrictionMode        String  @default("disabled")
  adminIpRestrictionMode   String  @default("disabled")
  githubWebhookSecret      String?
  githubImportIssues       Boolean @default(false)
  githubImportPrs          Boolean @default(false)
  githubDefaultProductId   String?
}

// ── IP access restrictions ─────────────────────────────────────────────────────

model IpRestriction {
  id          String   @id @default(uuid())
  cidr        String
  listType    String   @default("allowlist")
  description String?
  createdAt   DateTime @default(now())

  @@unique([cidr, listType])
}

model AdminIpRestriction {
  id          String   @id @default(uuid())
  cidr        String
  listType    String   @default("allowlist")
  description String?
  createdAt   DateTime @default(now())

  @@unique([cidr, listType])
}

// ── Announcements (server-wide) ───────────────────────────────────────────────

model Announcement {
  id              String   @id @default(uuid())
  title           String
  content         String
  authorId        String?
  teamId          String?
  pinned          Boolean  @default(false)
  commentsEnabled Boolean  @default(true)
  postedAsRole    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt

  author   User?                 @relation(fields: [authorId], references: [id], onDelete: SetNull)
  team     Team?                 @relation(fields: [teamId], references: [id], onDelete: SetNull)
  comments AnnouncementComment[]

  @@index([createdAt(sort: Desc)])
}

model AnnouncementComment {
  id             String    @id @default(uuid())
  announcementId String
  authorId       String?
  content        String
  postedAsRole   String?
  createdAt      DateTime  @default(now())
  editedAt       DateTime?

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  author       User?        @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([announcementId])
}

// ── Admin ─────────────────────────────────────────────────────────────────────

model EmailWhitelist {
  id        String   @id @default(uuid())
  pattern   String   @unique
  type      String   @default("allow")
  createdAt DateTime @default(now())
}

model AdminLog {
  id         String   @id @default(uuid())
  action     String
  actorId    String?
  actorName  String?
  targetId   String?
  targetName String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([createdAt(sort: Desc)])
  @@index([action])
}

// ── WebSocket upgrade tickets (DB-backed for multi-replica correctness) ───────

model WsTicket {
  token     String   @id
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

// ── SSO state (DB-backed so callbacks work across multiple replicas) ──────────

model SsoState {
  state        String   @id
  codeVerifier String
  nonce        String
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([expiresAt])
}

// ── File uploads ─────────────────────────────────────────────────────────────

model FileUpload {
  id         String   @id @default(uuid())
  filename   String   @unique
  uploaderId String
  productId  String?
  createdAt  DateTime @default(now())

  uploader User     @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  product  Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([uploaderId])
  @@index([productId])
}

// ── Activity log ──────────────────────────────────────────────────────────────

// Non-admin conversations (DMs and groups) are scoped to the project they were started in -
// `productId` is always null for admin-chat conversations (isAdminChat: true), which stay
// deliberately unscoped since server admins are allowed to contact anyone directly. A non-admin
// conversation's participants must all be members of `productId`'s team at creation time (enforced
// in routes/conversations.ts, not here) so chat never bleeds across unrelated projects.
model Conversation {
  id           String                    @id @default(uuid())
  isAdminChat  Boolean                   @default(false)
  closed       Boolean                   @default(false)
  isGroup      Boolean                   @default(false)
  name         String?
  productId    String?
  product      Product?                  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt    DateTime                  @default(now())
  participants ConversationParticipant[]
  messages     DirectMessage[]

  @@index([productId, isAdminChat])
}

model ConversationParticipant {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt     DateTime?

  @@unique([conversationId, userId])
  @@index([userId])
}

model DirectMessage {
  id             String        @id @default(uuid())
  conversationId String
  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  authorId       String
  author         User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content        String
  replyToId      String?
  replyTo        DirectMessage? @relation("DmReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies        DirectMessage[] @relation("DmReplies")
  createdAt      DateTime      @default(now())
  editedAt       DateTime?

  @@index([conversationId])
}

model ActivityEvent {
  id        String   @id @default(uuid())
  productId String
  actorId   String
  action    String
  entityType String
  entityId  String?
  entityName String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([productId])
  @@index([productId, createdAt])
}
