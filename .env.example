# Copy to .env and fill in values
# Generate secrets with: openssl rand -hex 32

# ╔══════════════════════════════════════════════════════════════╗
# ║                        MANDATORY                             ║
# ╚══════════════════════════════════════════════════════════════╝

# ── Database ─────────────────────────────────────────────────────────────────
DB_PASSWORD=changeme

# ── Authentication ───────────────────────────────────────────────────────────
# JWT signing secret - minimum 32 chars
JWT_SECRET=changeme

# Encryption key for secrets at rest (SMTP passwords, webhook secrets, TOTP)
ENCRYPTION_KEY=changeme

# ── Admin ────────────────────────────────────────────────────────────────────
# Whoever registers with this email becomes server owner (founding admin)
# Required on a fresh install - without it no admin account is created
ADMIN_EMAIL=you@example.com

# ── File Storage ─────────────────────────────────────────────────────────────
# Host directory where uploaded files (chat attachments etc.) are stored
# Use an absolute path or a path relative to this directory
UPLOADS_DIR=./data/uploads

# ╔══════════════════════════════════════════════════════════════╗
# ║                         OPTIONAL                             ║
# ╚══════════════════════════════════════════════════════════════╝

# ── Admin ────────────────────────────────────────────────────────────────────
# Set before first start to use a known password; omit to get a generated one printed to the log
# ADMIN_PASSWORD=MyChosenPassword123!

# Transfer server ownership on next restart (remove after use)
# RECROWN_EMAIL=new-owner@example.com

# ── Contact ──────────────────────────────────────────────────────────────────
# Email shown in the Terms of Service and Privacy Policy for user enquiries.
# Defaults to ADMIN_EMAIL if not set.
# CONTACT_EMAIL=you@example.com

# ── Server ───────────────────────────────────────────────────────────────────
# Port the frontend is served on - only used in dev (docker-compose.yml)
# In production (docker-compose.prod.yml), Traefik handles ports 80/443 automatically
# FRONTEND_PORT=80

# Number of trusted reverse proxy hops in front of the app (default 1 for Docker Compose nginx)
# Set to 0 if running without a reverse proxy
# TRUSTED_PROXY_DEPTH=1

# Set to "false" only for local HTTP-only development (no TLS)
# COOKIE_SECURE=false

# ── Production TLS ───────────────────────────────────────────────────────────
# Required when using docker-compose.prod.yml
# DOMAIN=planly.yourdomain.com
# ACME_EMAIL=admin@yourdomain.com

# ── Email / SMTP ─────────────────────────────────────────────────────────────
# Can also be configured via Admin -> Email in the UI
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false         # true for port 465 (SMTPS); false for STARTTLS on 587
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-16-char-app-password
# SMTP_FROM=Planly <noreply@yourdomain.com>

# ── Single Sign-On (OIDC) ────────────────────────────────────────────────────
# Enables "Sign in with <provider>" on the login page
# Works with any OpenID Connect provider: Google, Microsoft Entra, Auth0, Okta, Keycloak, ...
# Register this callback URL with your provider: <APP_URL>/api/auth/sso/callback
#
# Google:    OIDC_ISSUER=https://accounts.google.com
# Microsoft: OIDC_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
# Auth0:     OIDC_ISSUER=https://<your-tenant>.auth0.com
#
# OIDC_ISSUER=https://accounts.google.com
# OIDC_CLIENT_ID=your-client-id
# OIDC_CLIENT_SECRET=your-client-secret
# OIDC_PROVIDER_NAME=Google

# ── File Storage (S3) ────────────────────────────────────────────────────────
# Set AWS_S3_BUCKET to store uploads in S3-compatible storage instead of the local UPLOADS_DIR
#
# AWS S3:
# AWS_S3_BUCKET=planly-uploads
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
# AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
#
# Scaleway Object Storage:
# AWS_S3_BUCKET=planly-uploads
# AWS_REGION=nl-ams-1
# AWS_ENDPOINT_URL=https://s3.nl-ams.scw.cloud
# AWS_ACCESS_KEY_ID=<Scaleway access key ID>
# AWS_SECRET_ACCESS_KEY=<Scaleway secret key>
#
# Self-hosted MinIO (see MinIO block in docker-compose.yml):
# AWS_S3_BUCKET=planly
# AWS_REGION=us-east-1
# AWS_ENDPOINT_URL=http://minio:9000
# AWS_ACCESS_KEY_ID=planly
# AWS_SECRET_ACCESS_KEY=changeme
#
# Prefix path inside the bucket (default: planly-uploads)
# AWS_S3_PREFIX=planly-uploads

# ── Logging ──────────────────────────────────────────────────────────────────
# LOG_FORMAT=pretty  # human-readable in dev; leave unset in prod (outputs raw JSON)
# LOG_LEVEL=info     # debug | info | warn | error

# ── Metrics ──────────────────────────────────────────────────────────────────
# Prometheus-compatible scrape endpoint at GET /api/metrics
# If set, requests must include X-Metrics-Secret: <value>
# Leave unset only on a private network (exposes metrics without auth)
# METRICS_SECRET=change-me-to-a-random-secret

# ── Security Alerts ──────────────────────────────────────────────────────────
# POST to this URL on high-severity events (account lockouts, brute force, etc.)
# Supports Slack incoming webhooks, Discord webhooks, or any HTTP JSON endpoint
# SECURITY_ALERT_WEBHOOK_URL=https://hooks.slack.com/services/...

# ── Audit Log Retention ──────────────────────────────────────────────────────
# How many days of audit logs to keep before they are automatically deleted
# Default is 90 days (GDPR-friendly) - increase if you need longer retention
# ADMIN_LOG_RETENTION_DAYS=90

# ── Encryption Key Rotation ──────────────────────────────────────────────────
# Run scripts/rotate-encryption-key.ts when rotating
# Recommended: annually or when a team member with key access leaves
# OLD_ENCRYPTION_KEY=<old> NEW_ENCRYPTION_KEY=<new> DATABASE_URL=<url> npx tsx scripts/rotate-encryption-key.ts

# ── Rate Limits ──────────────────────────────────────────────────────────────
# Defaults are 10 logins / 5 registrations per window per IP (safe for production)
# For local E2E test runs against the Docker stack, raise these so test suites
# don't exhaust the budget across many test accounts:
# RATE_LIMIT_LOGIN_MAX=1000
# RATE_LIMIT_REGISTER_MAX=1000

# ── Kubernetes / Custom Backend URL ──────────────────────────────────────────
# The frontend nginx reverse-proxies /api/ to the backend
# Override only when deploying on Kubernetes or with a differently-named service
# BACKEND_URL=http://planly-backend:3000
