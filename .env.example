# Copy to .env and fill in values

# PostgreSQL password (any strong string)
DB_PASSWORD=changeme

# JWT signing secret — minimum 32 chars (generate with: openssl rand -hex 32)
JWT_SECRET=changeme

# Encryption key for secrets at rest (SMTP passwords, webhook secrets)
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=changeme

# Set to "false" only for local HTTP-only development (no TLS)
# COOKIE_SECURE=false

# Number of trusted reverse proxy hops in front of the app (default 1 for Docker Compose nginx)
# Set to 0 if running without a reverse proxy (direct internet exposure)
# TRUSTED_PROXY_DEPTH=1

# Port the frontend is served on (default 80) — only used in dev (docker-compose.yml)
# In production (docker-compose.prod.yml), Traefik handles ports 80/443 automatically.
FRONTEND_PORT=80

# Production TLS (required when using docker-compose.prod.yml)
# DOMAIN=planly.yourdomain.com
# ACME_EMAIL=admin@yourdomain.com

# SMTP credentials (optional — configure via Settings → Email in the UI instead)
# If set here, also uncomment the matching SMTP_* lines in docker-compose.yml.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-16-char-app-password

# Admin email (optional — whoever registers with this email becomes server owner)
# ADMIN_EMAIL=you@example.com

# Security alerting (optional — POST to this URL on high-severity events like account lockouts)
# Supports Slack incoming webhooks, Discord webhooks, or any HTTP JSON endpoint
# SECURITY_ALERT_WEBHOOK_URL=https://hooks.slack.com/services/...

# Admin audit log retention (default 365 days — automated cleanup runs every 24h)
# ADMIN_LOG_RETENTION_DAYS=365

# ENCRYPTION_KEY rotation: run scripts/rotate-encryption-key.ts when rotating.
# Recommended cadence: annually or whenever a team member with key access leaves.
# OLD_ENCRYPTION_KEY=<old> NEW_ENCRYPTION_KEY=<new> DATABASE_URL=<url> npx tsx scripts/rotate-encryption-key.ts

# Single Sign-On / OIDC (optional — enables "Sign in with <provider>" on the login page)
# Works with any OpenID Connect provider: Google, Microsoft Entra, Auth0, Okta, Keycloak, …
# The callback URL to register with your provider: <APP_URL>/api/auth/sso/callback
#
# Google:    OIDC_ISSUER=https://accounts.google.com
# Microsoft: OIDC_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
# Auth0:     OIDC_ISSUER=https://<your-tenant>.auth0.com
#
# OIDC_ISSUER=https://accounts.google.com
# OIDC_CLIENT_ID=your-client-id
# OIDC_CLIENT_SECRET=your-client-secret
# OIDC_PROVIDER_NAME=Google

# ── File uploads: S3-compatible object storage (optional) ───────────────────
# By default, uploaded files are stored on the server at ./data/uploads/ (a bind
# mount — persists across deploys and even docker compose down -v).
# Set AWS_S3_BUCKET to switch to S3-compatible storage instead; UPLOADS_DIR is ignored when set.
#
# AWS S3:
# AWS_S3_BUCKET=planly-uploads
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
# AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
#
# Scaleway Object Storage:
# AWS_S3_BUCKET=planly-uploads
# AWS_REGION=nl-ams-1                            # or fr-par-1, pl-waw-1
# AWS_ENDPOINT_URL=https://s3.nl-ams.scw.cloud
# AWS_ACCESS_KEY_ID=<Scaleway access key ID>
# AWS_SECRET_ACCESS_KEY=<Scaleway secret key>
#
# Self-hosted MinIO (see MinIO block in docker-compose.yml):
# AWS_S3_BUCKET=planly
# AWS_REGION=us-east-1
# AWS_ENDPOINT_URL=http://minio:9000
# AWS_ACCESS_KEY_ID=planly
# AWS_SECRET_ACCESS_KEY=changeme
#
# Optional: prefix path inside the bucket (default: planly-uploads)
# AWS_S3_PREFIX=planly-uploads

# ── Kubernetes / custom backend URL (optional) ───────────────────────────────
# The frontend nginx reverse-proxies /api/ to the backend. In Docker Compose
# the backend service is always reachable as http://backend:3000 (the default).
# Override only when deploying on Kubernetes or with a differently-named service.
# BACKEND_URL=http://planly-backend:3000

# Logging
# LOG_FORMAT=pretty   # set this in dev for human-readable colourised output; leave unset in prod (raw JSON for log aggregators)
# LOG_LEVEL=info      # debug | info | warn | error

# Metrics (Prometheus-compatible scrape endpoint at GET /api/metrics)
# If set, requests must include X-Metrics-Secret: <value> to read metrics.
# Leave unset to expose metrics without authentication (only do this on a private network).
# METRICS_SECRET=change-me-to-a-random-secret
