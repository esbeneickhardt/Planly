# Copy to .env and fill in values

# PostgreSQL password (any strong string)
DB_PASSWORD=changeme

# JWT signing secret (generate with: openssl rand -hex 32)
JWT_SECRET=changeme

# Port the frontend is served on (default 80)
FRONTEND_PORT=80

# SMTP credentials (optional — configure via Settings → Email in the UI instead)
# If set here, also uncomment the matching SMTP_* lines in docker-compose.yml.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-16-char-app-password

# Admin email (optional — whoever registers with this email becomes server owner)
# ADMIN_EMAIL=you@example.com
